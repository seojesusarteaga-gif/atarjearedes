---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Migas from '../components/Migas.astro';
import { SITE } from '../data/site';
import { construirGrafo, type Miga } from '../lib/schema';
import type { Faq } from '../data/servicios';

interface Props {
  title: string;
  meta: string;
  ruta: string;
  migas?: Miga[];
  faqs?: Faq[];
  servicio?: { nombre: string; descripcion: string; tipo?: string };
  entrada?: { titulo: string; descripcion: string; fecha: string; imagen?: string };
  imagen?: string;
}

const { title, meta, ruta, migas = [], faqs, servicio, entrada, imagen } = Astro.props;

const canonical = `${SITE.url}${ruta === '/' ? '/' : ruta}`;
const grafo = construirGrafo({ ruta, migas, faqs, servicio, entrada });
const og = `${SITE.url}${imagen ?? '/img/paginas/home.svg'}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={meta} />
    <link rel="canonical" href={canonical} />

    <!-- Bloqueo de indexacion deliberado hasta la Fase M6 (ver public/robots.txt) -->
    <meta name="robots" content="noindex, nofollow" />

    <meta property="og:type" content={entrada ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={meta} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(grafo)} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header ruta={ruta} />
    {migas.length > 0 && <div class="contenedor"><Migas items={migas} /></div>}
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
