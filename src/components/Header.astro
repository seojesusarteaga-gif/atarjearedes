---
import { SITE, MENU } from '../data/site';
interface Props { ruta: string }
const { ruta } = Astro.props;
const activa = (href: string) => ruta === href || (href !== '/' && ruta.startsWith(href + '/'));
---

<header class="cabecera">
  <div class="contenedor cabecera__fila">
    <a class="cabecera__logo" href="/" aria-label={`${SITE.nombre} — inicio`}>
      <img src="/logo.svg" alt={SITE.nombre} width="190" height="53" />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-principal"
      aria-label="Abrir menú de navegación"
    >
      <span class="nav-toggle__barras" aria-hidden="true"></span>
      <span class="nav-toggle__texto">Menú</span>
    </button>

    <nav class="nav" id="nav-principal" aria-label="Navegación principal">
      <ul>
        {MENU.map((m) => (
          <li>
            <a href={m.href} aria-current={activa(m.href) ? 'page' : undefined}>{m.texto}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="cabecera__tel" href={SITE.telefonoHref}>
      {SITE.telefono}
      {SITE.telefonoPendiente && <span class="pendiente">provisional</span>}
    </a>
  </div>
</header>

<script is:inline>
  // Menu movil. Inline a proposito: son ~500 bytes y evita una peticion de JS
  // en un sitio que por lo demas no carga nada de JavaScript.
  (function () {
    var b = document.querySelector('.nav-toggle');
    var n = document.getElementById('nav-principal');
    if (!b || !n) return;

    function set(abierto) {
      b.setAttribute('aria-expanded', String(abierto));
      b.setAttribute('aria-label', (abierto ? 'Cerrar' : 'Abrir') + ' menú de navegación');
      n.classList.toggle('nav--abierta', abierto);
    }

    b.addEventListener('click', function () {
      set(b.getAttribute('aria-expanded') !== 'true');
    });

    // Escape cierra y devuelve el foco al boton
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && b.getAttribute('aria-expanded') === 'true') {
        set(false);
        b.focus();
      }
    });

    // Al navegar dentro del menu, se cierra
    n.addEventListener('click', function (e) {
      if (e.target.closest('a')) set(false);
    });

    // Si se pasa a escritorio con el menu abierto, se resetea el estado
    window.matchMedia('(min-width: 1024px)').addEventListener('change', function (e) {
      if (e.matches) set(false);
    });
  })();
</script>
