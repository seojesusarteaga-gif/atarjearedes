---
import type { Tarjeta } from '../data/segmentos';
interface Props { items: Tarjeta[]; columnas?: 2 | 3 | 4 }
const { items, columnas = 3 } = Astro.props;
---
<div class={`rejilla rejilla--${columnas}`}>
  {items.map((t) => (
    <article class="tarjeta">
      <img src={t.imagen} alt={t.alt} width="1600" height="700" loading="lazy" />
      <div class="tarjeta__cuerpo">
        <span class="tarjeta__etiqueta">{t.etiqueta}</span>
        <h3><a href={t.href}>{t.titular}</a></h3>
        <p>{t.resumen}</p>
        <p class="tarjeta__pie"><a href={t.href}>{t.nombre}</a></p>
      </div>
    </article>
  ))}
</div>
