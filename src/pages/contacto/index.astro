---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
import { SEGMENTOS, TICKET_ALTO } from '../../data/segmentos';
import { MUNICIPIOS_NUCLEO } from '../../data/municipios';

const asuntos = [...SEGMENTOS, ...TICKET_ALTO];
const zonasDestacadas = MUNICIPIOS_NUCLEO.slice(0, 8);
---

<Base
  title="Contacto: saneamiento en Sevilla | Atarjea Redes"
  meta="Contacta con Atarjea Redes: urgencias de saneamiento, inspección con cámara y contratos de mantenimiento en Sevilla y área metropolitana."
  ruta="/contacto"
  imagen="/img/paginas/contacto.svg"
  migas={[{ nombre: 'Inicio', href: '/' }, { nombre: 'Contacto', href: '/contacto' }]}
>
  <section class="seccion">
    <div class="contenedor">
      <div class="estrecho">
        {/* H1 cambiado en M5.5, con aprobacion expresa: el anterior era solo
            "Contacto", sin keyword ni ciudad. Es el unico H1 modificado del
            sitio; los otros 47 quedan congelados por la regla del manual. */}
        <h1>Contacto: saneamiento y desatascos en Sevilla</h1>
        <p>
          Si es una urgencia, llama: es más rápido que cualquier formulario. Para
          inspecciones, contratos de mantenimiento o presupuestos con calma, escríbenos y
          te respondemos.
        </p>
      </div>

      <div class="rejilla rejilla--2" style="margin-top:2rem;align-items:start">
        <div>
          <h2 style="margin-top:0">Datos de contacto</h2>
          <dl class="datos" style="grid-template-columns:1fr">
            <div class="dato">
              <dt>Teléfono</dt>
              <dd>
                <a href={SITE.telefonoHref}>{SITE.telefono}</a>
              </dd>
              {SITE.telefonoPendiente && (
                <p style="margin:.6rem 0 0">
                  <span class="pendiente">
                    Número provisional: la línea todavía no está operativa
                  </span>
                </p>
              )}
            </div>
            <div class="dato">
              <dt>Email</dt>
              <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
            </div>
            <div class="dato">
              <dt>Zona</dt>
              <dd>{SITE.direccion.barrio}, {SITE.direccion.localidad}</dd>
              {SITE.direccion.pendiente && (
                <p style="margin:.6rem 0 0">
                  <span class="pendiente">Dirección exacta pendiente de publicar</span>
                </p>
              )}
            </div>
            <div class="dato">
              <dt>Horario</dt>
              <dd>{SITE.horario}</dd>
            </div>
          </dl>

          <div class="aviso">
            <strong>Sitio en construcción.</strong> Los datos marcados como provisionales
            no son información de contacto real todavía. El formulario, en cambio, sí
            funciona: lo que nos escribas nos llega al momento.
          </div>
        </div>

        <div>
          <h2 style="margin-top:0">Escríbenos</h2>
          <form
            id="form-contacto"
            class="formulario"
            method="post"
            action="/api/contact"
            aria-describedby="form-nota"
          >
            <p id="form-nota" class="formulario__nota">
              Todos los campos son obligatorios salvo el servicio y la zona.
            </p>

            <label for="nombre">Nombre</label>
            <input
              id="nombre"
              name="nombre"
              type="text"
              autocomplete="name"
              required
              minlength="2"
              maxlength="120"
            />

            <label for="telefono">
              Teléfono <span class="formulario__ayuda">(al menos 9 cifras)</span>
            </label>
            <input
              id="telefono"
              name="telefono"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              required
              maxlength="30"
              pattern={'[0-9 +.\\(\\)\\-]{9,30}'}
            />

            <label for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="160"
            />

            <label for="tipoServicio">
              ¿Qué necesitas? <span class="formulario__ayuda">(opcional)</span>
            </label>
            <select id="tipoServicio" name="tipoServicio">
              <option value="">Selecciona una opción</option>
              {asuntos.map((a) => <option value={a.nombre}>{a.nombre}</option>)}
              <option value="Otra cosa">Otra cosa</option>
            </select>

            <label for="zona">
              Municipio o barrio <span class="formulario__ayuda">(opcional)</span>
            </label>
            <input
              id="zona"
              name="zona"
              type="text"
              autocomplete="address-level2"
              maxlength="120"
            />

            <label for="mensaje">Cuéntanos el caso</label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="5"
              required
              minlength="3"
              maxlength="3000"
            ></textarea>

            {/* Honeypot: invisible para las personas. Si llega relleno, es un bot
                y el endpoint lo descarta en silencio. */}
            <input type="text" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

            {/* Deshabilitado en el HTML: lo activa el script. Sin JavaScript el
                envio no funcionaria, y asi no se pierde ningun mensaje en silencio. */}
            <button class="boton boton--claro" type="submit" disabled style="margin-top:1rem">
              Enviar mensaje
            </button>

            <noscript>
              <p class="formulario__nota" style="margin-top:.8rem">
                Para enviar el formulario hace falta JavaScript. También puedes
                escribirnos a <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
              </p>
            </noscript>

            <p
              id="form-ok"
              class="formulario__estado formulario__estado--ok"
              role="status"
              tabindex="-1"
              hidden
            >
              <strong>Mensaje enviado.</strong> Lo hemos recibido y te contestamos por
              teléfono o por email.
            </p>
            <p
              id="form-error"
              class="formulario__estado formulario__estado--error"
              role="alert"
              tabindex="-1"
              hidden
            >
              {/* Astro borra el espacio entre elementos en linea separados por un
                  salto de linea: por eso el {' '} explicito y el espacio final que
                  anade el script al motivo del error. */}
              <strong>No se ha podido enviar.</strong>{' '}
              <span id="form-error-detalle"></span>Inténtalo de nuevo en un momento o
              escríbenos a <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
            </p>
          </form>
        </div>
      </div>

      <div class="estrecho" style="margin-top:3rem">
        <h2>Antes de escribir, quizá esté aquí</h2>
        <p>
          Buena parte de las dudas se resuelven en la página del servicio o en la de tu
          zona, donde explicamos qué suele fallar en cada tipo de red.
        </p>

        <h3>Según quién eres</h3>
        <ul class="enlaces">
          {SEGMENTOS.map((s) => <li><a href={s.href}>{s.nombre}</a></li>)}
        </ul>

        <h3>Trabajo técnico</h3>
        <ul class="enlaces">
          {TICKET_ALTO.map((t) => <li><a href={t.href}>{t.nombre}</a></li>)}
        </ul>

        <h3>Tu zona</h3>
        <ul class="enlaces">
          <li><a href="/zonas/sevilla">Sevilla capital</a></li>
          {zonasDestacadas.map((z) => <li><a href={`/zonas/${z.slug}`}>{z.nombre}</a></li>)}
          <li><a href="/zonas"><strong>Todas las zonas</strong></a></li>
        </ul>

        <p style="margin-top:1.6rem">
          También puedes ver <a href="/servicios">todos los servicios</a> o
          <a href="/por-que-nosotros">qué hacemos distinto</a>.
        </p>
      </div>
    </div>
  </section>

  <style>
    .formulario label {
      display: block;
      font-size: 0.85rem;
      font-weight: 650;
      color: var(--tinta);
      margin: 0.9rem 0 0.3rem;
    }
    .formulario input,
    .formulario select,
    .formulario textarea {
      width: 100%;
      padding: 0.6rem 0.7rem;
      border: 1px solid var(--borde);
      border-radius: var(--radio);
      font: inherit;
      font-size: 0.95rem;
      background: var(--blanco);
      color: var(--texto);
    }
    .formulario input:disabled,
    .formulario select:disabled,
    .formulario textarea:disabled {
      background: var(--fondo-alt);
      color: var(--texto-sec);
      cursor: not-allowed;
    }
    .formulario button:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }
    /* global.css no trae regla para [hidden]: sin esto, cualquier display de
       una clase podria mostrar los mensajes de estado antes de tiempo. */
    .formulario [hidden] {
      display: none !important;
    }
    .formulario__nota {
      margin: 0 0 0.4rem;
      font-size: 0.85rem;
      color: var(--texto-sec);
    }
    .formulario__ayuda {
      font-weight: 400;
      color: var(--texto-sec);
    }
    .formulario__estado {
      margin: 1rem 0 0;
      padding: 0.8rem 1rem;
      border: 1px solid;
      border-radius: var(--radio);
      font-size: 0.92rem;
    }
    .formulario__estado--ok {
      background: #eaf4ee;
      border-color: #2f7a4f;
      color: #1e5235;
    }
    .formulario__estado--error {
      background: #fbecea;
      border-color: #b3412f;
      color: #7a2a1e;
    }
    .formulario__estado a {
      color: inherit;
    }
  </style>

  <script is:inline>
    // Envio del formulario de contacto (Fase RR3). Inline, como el menu: son
    // pocos bytes y el sitio no carga ningun JavaScript externo.
    (function () {
      var f = document.getElementById('form-contacto');
      if (!f || !window.fetch) return;
      var boton = f.querySelector('button[type="submit"]');
      var ok = document.getElementById('form-ok');
      var ko = document.getElementById('form-error');
      var detalle = document.getElementById('form-error-detalle');
      var textoBoton = boton.textContent;
      var campos = ['nombre', 'telefono', 'email', 'mensaje', 'tipoServicio', 'zona', 'botcheck'];
      var enviando = false;

      boton.disabled = false;

      f.addEventListener('submit', function (e) {
        e.preventDefault();
        if (enviando) return;
        enviando = true;
        ok.hidden = true;
        ko.hidden = true;
        detalle.textContent = '';
        boton.disabled = true;
        boton.textContent = 'Enviando…';

        var d = new FormData(f);
        var datos = {};
        campos.forEach(function (k) {
          datos[k] = String(d.get(k) || '');
        });

        fetch(f.getAttribute('action'), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datos),
        })
          .then(function (r) {
            return r
              .json()
              .catch(function () {
                return {};
              })
              .then(function (j) {
                if (!r.ok) {
                  // Solo los errores de validacion traen un motivo util para el usuario.
                  if (r.status === 400 && j.error) detalle.textContent = j.error + '. ';
                  throw new Error('HTTP ' + r.status);
                }
              });
          })
          .then(function () {
            f.reset();
            ok.hidden = false;
            ok.focus();
          })
          .catch(function () {
            ko.hidden = false;
            ko.focus();
          })
          .then(function () {
            enviando = false;
            boton.disabled = false;
            boton.textContent = textoBoton;
          });
      });
    })();
  </script>
</Base>
