---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Citable from '../components/Citable.astro';
import Tarjetas from '../components/Tarjetas.astro';
import Cta from '../components/Cta.astro';
import { SEGMENTOS, TICKET_ALTO } from '../data/segmentos';
import { MUNICIPIOS } from '../data/municipios';
import { BARRIOS } from '../data/barrios';

const citable =
  'Atarjea Redes es una empresa de redes de saneamiento y canalizaciones que opera en Sevilla capital y su área metropolitana. Su actividad se organiza en tres líneas: mantenimiento preventivo de redes para comunidades de propietarios, hostelería e industria; diagnóstico técnico mediante inspección con cámara y rehabilitación de tuberías sin obra; y desatascos de urgencia en vivienda y local. La empresa trabaja con administradores de fincas emitiendo factura a la comunidad de propietarios, y aplica el criterio de no presupuestar una reparación sin haber inspeccionado antes la conducción.';

// Las cinco puertas de entrada que pide la home: los cuatro segmentos y la camara.
const puertas = [...SEGMENTOS, TICKET_ALTO[0]];
const otrosTicketAlto = TICKET_ALTO.slice(1);
---

<Base
  title="Redes de saneamiento y canalizaciones en Sevilla | Atarjea Redes"
  meta="Empresa de redes de saneamiento en Sevilla y área metropolitana. Inspección con cámara, rehabilitación de tuberías sin obra, mantenimiento para comunidades, hostelería e industria."
  ruta="/"
  imagen="/img/paginas/home.svg"
>
  <Hero
    h1="Redes de saneamiento y canalizaciones en Sevilla"
    entradilla="Diagnóstico técnico, rehabilitación sin obra y mantenimiento preventivo para comunidades, hostelería e industria. Y desatascos de urgencia cuando hacen falta."
    imagen="/img/paginas/home.svg"
    alt="Redes de saneamiento y canalizaciones en Sevilla"
    textoSec="Soy administrador de fincas"
    hrefSec="/administradores-de-fincas"
  />

  <section class="seccion">
    <div class="contenedor">
      <div class="estrecho">
        <Citable texto={citable} />
        <p>
          La mayoría de las empresas del sector venden el desatasco. Nosotros trabajamos
          la red completa: qué la ha estropeado, cómo se repara sin abrir zanja y qué
          mantenimiento evita que vuelva a pasar. El desatasco urgente es la parte visible
          del trabajo, no el trabajo entero.
        </p>
      </div>
    </div>
  </section>

  <section class="seccion seccion--alt">
    <div class="contenedor">
      <h2>¿Desde dónde nos llamas?</h2>
      <p class="estrecho">
        Un administrador de fincas y un vecino con el váter atascado no necesitan lo mismo,
        ni tienen las mismas dudas. Empieza por tu caso.
      </p>
      <Tarjetas items={puertas} columnas={3} />
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <h2>Trabajo técnico de ticket alto</h2>
      <p class="estrecho">
        Cuando la inspección revela que la conducción está dañada, la reparación no tiene
        por qué implicar obra. Y cuando la actividad es hostelera, hay una obligación
        normativa que cumplir.
      </p>
      <Tarjetas items={otrosTicketAlto} columnas={2} />
    </div>
  </section>

  <section class="seccion seccion--alt">
    <div class="contenedor">
      <h2>Dónde trabajamos</h2>
      <p class="estrecho">
        Sevilla capital y {MUNICIPIOS.length} municipios del área metropolitana, con el
        Aljarafe como zona de intervención inmediata. Decimos en cada zona qué tiempo de
        respuesta podemos sostener de verdad.
      </p>
      <ul class="enlaces">
        <li><a href="/zonas/sevilla"><strong>Sevilla capital</strong></a></li>
        {BARRIOS.map((b) => <li><a href={`/zonas/sevilla/${b.slug}`}>{b.nombre}</a></li>)}
        {MUNICIPIOS.map((m) => <li><a href={`/zonas/${m.slug}`}>{m.nombre}</a></li>)}
      </ul>
      <p style="margin-top:1.4rem">
        <a class="boton boton--claro" href="/zonas">Ver todas las zonas de cobertura</a>
      </p>
    </div>
  </section>

  <Cta
    titulo="¿Hablamos de tu red?"
    texto="Si es una urgencia, llama. Si es un contrato de mantenimiento o una comunidad con bajantes al final de su vida útil, escríbenos y lo vemos con calma."
  />
</Base>
