---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Citable from '../../components/Citable.astro';
import Faqs from '../../components/Faqs.astro';
import Cta from '../../components/Cta.astro';
import Datos from '../../components/Datos.astro';
import EnlacesServicios from '../../components/EnlacesServicios.astro';
import { MUNICIPIOS, nota } from '../../data/municipios';
import { PERFILES } from '../../data/perfiles';
import { SEGMENTOS } from '../../data/segmentos';

export function getStaticPaths() {
  // Sevilla capital NO entra aqui: tiene pagina propia en zonas/sevilla.astro
  // porque ademas lista los cinco distritos.
  return MUNICIPIOS.map((m) => ({ params: { municipio: m.slug }, props: { m } }));
}

const { m } = Astro.props;
const perfil = PERFILES[m.perfil];

const poblacion = m.poblacion
  ? {
      etiqueta: 'Población',
      valor: `${m.poblacion.toLocaleString('es-ES')} habitantes`,
    }
  : { etiqueta: 'Población', valor: 'Pendiente de verificar en INE / SIMA', pendiente: true };

const datos = [
  poblacion,
  { etiqueta: 'Distancia', valor: `${m.km} km del centro de Sevilla` },
  { etiqueta: 'Servicio dominante', valor: m.servicioDominante },
];

const esOrganica = m.zona === 'organica';

// Municipios del mismo perfil de red: enlazado lateral con criterio, no aleatorio.
const hermanos = MUNICIPIOS.filter((x) => x.perfil === m.perfil && x.slug !== m.slug).slice(0, 5);

// El CTA se ajusta al servicio dominante, no es el mismo en las 17 paginas.
const CTA: Record<string, { titulo: string; texto: string; textoSec: string; hrefSec: string }> = {
  'bloque-antiguo': {
    titulo: `¿La misma bajante da problemas otra vez en ${m.nombre}?`,
    texto: 'Si vuelve cada pocos meses, el tapón no es el problema: lo es la sección del conducto. Te decimos si basta con limpiar a fondo o si conviene mirarlo con cámara.',
    textoSec: 'Hablar de la comunidad',
    hrefSec: '/administradores-de-fincas',
  },
  urbanizacion: {
    titulo: `¿Sabéis por dónde va la red de vuestra urbanización en ${m.nombre}?`,
    texto: 'Localizamos las arquetas, limpiamos el tramo completo y os dejamos identificado el trazado, para que la siguiente intervención no empiece de cero.',
    textoSec: 'Pedir revisión de la red',
    hrefSec: '/contacto',
  },
  mixto: {
    titulo: `¿Bloque o urbanización? En ${m.nombre} cambia el servicio`,
    texto: 'Dinos qué tipo de edificación es y cuántos desagües fallan. Con eso sale el equipo correcto a la primera y te ahorras una segunda visita.',
    textoSec: 'Ver servicios',
    hrefSec: '/servicios',
  },
  diseminado: {
    titulo: `¿Cuándo se vació la fosa por última vez en ${m.nombre}?`,
    texto: 'Si no lo recuerdas, probablemente toque. Vaciado con cuba, retirada por gestor autorizado y justificante. Indícanos el acceso y lo resolvemos en una visita.',
    textoSec: 'Ver fosas sépticas y pozos',
    hrefSec: '/servicios/fosas-septicas-y-pozos',
  },
  industrial: {
    titulo: `¿Cuándo te viene bien que entremos en ${m.nombre}?`,
    texto: 'Programamos en tu franja de menor actividad y salimos dentro de la ventana acordada, con el justificante de gestor autorizado en la mano.',
    textoSec: 'Pedir visita técnica',
    hrefSec: '/industrial',
  },
  ciudad: {
    titulo: `Trabajo programado en ${m.nombre}`,
    texto: 'Mantenimiento, inspección y rehabilitación, que no dependen de la proximidad inmediata. La urgencia a esta distancia la resuelve mejor alguien más cerca, y preferimos decirlo.',
    textoSec: 'Hablar de un contrato',
    hrefSec: '/administradores-de-fincas',
  },
};
const cta = CTA[m.perfil];
---

<Base
  title={`Saneamiento y desatascos ${m.nombre} | Atarjea Redes`}
  meta={m.meta}
  ruta={`/zonas/${m.slug}`}
  imagen={`/img/zonas/${m.slug}.svg`}
  faqs={m.faqs}
  servicio={{ nombre: `${m.servicioDominante} en ${m.nombre}`, descripcion: m.meta }}
  migas={[
    { nombre: 'Inicio', href: '/' },
    { nombre: 'Zonas', href: '/zonas' },
    { nombre: m.nombre, href: `/zonas/${m.slug}` },
  ]}
>
  <Hero
    h1={`Saneamiento y desatascos en ${m.nombre}`}
    entradilla={m.servicioDominante}
    imagen={`/img/zonas/${m.slug}.svg`}
    alt={`Saneamiento y desatascos en ${m.nombre}`}
    textoSec={cta.textoSec}
    hrefSec={cta.hrefSec}
  />

  <section class="seccion">
    <div class="contenedor estrecho">
      <Citable texto={m.citable} />

      {
        esOrganica && (
          <div class="aviso">
            <strong>Cobertura orgánica extendida.</strong> {nota(m.zona)} En {m.nombre}{' '}
            trabajamos sobre todo en programado: mantenimiento, inspección y
            rehabilitación. No prometemos tiempos de urgencia que a esta distancia no
            podríamos sostener.
          </div>
        )
      }

      <Datos items={datos} />

      <h2>Por qué {m.nombre} necesita un planteamiento propio</h2>
      <p>{m.porQue}</p>

      <table>
        <tbody>
          <tr><th scope="row">Tipo de red</th><td>{m.red}</td></tr>
          <tr><th scope="row">Parque de vivienda</th><td>{m.vivienda}</td></tr>
          <tr><th scope="row">Servicio con más recorrido</th><td>{m.servicioDominante}</td></tr>
          <tr><th scope="row">Nivel de cobertura</th><td>{nota(m.zona)}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="seccion seccion--alt">
    <div class="contenedor estrecho">
      <h2>{perfil.titulo}</h2>
      <p>{perfil.intro}</p>

      <h3>Las señales que aparecen antes del aviso</h3>
      <dl>
        {
          perfil.fallos.map((f) => (
            <>
              <dt><strong>{f.que}</strong></dt>
              <dd>{f.por}</dd>
            </>
          ))
        }
      </dl>

      <h3>Cómo lo abordamos</h3>
      <p>{perfil.enfoque}</p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor estrecho">
      <EnlacesServicios
        slugs={m.servicios}
        titulo={`Servicios que más se piden en ${m.nombre}`}
      />

      {
        hermanos.length > 0 && (
          <div style="margin-top:2rem">
            <h3>Municipios con el mismo tipo de red</h3>
            <p>
              Comparten problemática con {m.nombre}, así que el planteamiento técnico es
              parecido.
            </p>
            <ul class="enlaces">
              {hermanos.map((x) => (
                <li><a href={`/zonas/${x.slug}`}>{x.nombre}</a></li>
              ))}
              <li><a href="/zonas"><strong>Todas las zonas</strong></a></li>
            </ul>
          </div>
        )
      }

      <div style="margin-top:2rem">
        <h3>Según quién nos llame</h3>
        <ul class="enlaces">
          {SEGMENTOS.map((sg) => <li><a href={sg.href}>{sg.nombre}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <Faqs faqs={m.faqs} titulo={`Preguntas frecuentes en ${m.nombre}`} />

  <Cta titulo={cta.titulo} texto={cta.texto} textoSec={cta.textoSec} hrefSec={cta.hrefSec} />
</Base>
