---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import Citable from '../../../components/Citable.astro';
import Faqs from '../../../components/Faqs.astro';
import Cta from '../../../components/Cta.astro';
import EnlacesServicios from '../../../components/EnlacesServicios.astro';
import EnlacesBlog from '../../../components/EnlacesBlog.astro';
import { BARRIOS } from '../../../data/barrios';
import { SEGMENTOS } from '../../../data/segmentos';
import { resolverServicio } from '../../../data/enlaces';

export function getStaticPaths() {
  return BARRIOS.map((b) => ({ params: { barrio: b.slug }, props: { b } }));
}

const { b } = Astro.props;
const otros = BARRIOS.filter((x) => x.slug !== b.slug);

// El secundario del hero apunta al servicio dominante del distrito, no a un
// "pedir presupuesto" generico repetido en las cinco paginas.
const principal = resolverServicio(b.servicios[0]);
---

<Base
  title={b.title}
  meta={b.meta}
  ruta={`/zonas/sevilla/${b.slug}`}
  imagen={`/img/zonas/${b.slug}.svg`}
  faqs={b.faqs}
  servicio={{ nombre: b.servicioDominante, descripcion: b.meta }}
  migas={[
    { nombre: 'Inicio', href: '/' },
    { nombre: 'Zonas', href: '/zonas' },
    { nombre: 'Sevilla capital', href: '/zonas/sevilla' },
    { nombre: b.nombre, href: `/zonas/sevilla/${b.slug}` },
  ]}
>
  <Hero
    h1={b.h1}
    entradilla={b.servicioDominante}
    imagen={`/img/zonas/${b.slug}.svg`}
    alt={`${b.servicioDominante} en ${b.nombre}, Sevilla`}
    textoSec={principal ? `Ver ${principal.nombre.toLowerCase()}` : 'Ver servicios'}
    hrefSec={principal ? principal.href : '/servicios'}
  />

  <section class="seccion">
    <div class="contenedor estrecho">
      <Citable texto={b.citable} />

      <h2>Por qué {b.nombre} necesita este servicio y no otro</h2>
      <p>{b.porQue}</p>

      <table>
        <tbody>
          <tr><th scope="row">Parque edificado</th><td>{b.parque}</td></tr>
          <tr><th scope="row">Servicio con más recorrido</th><td>{b.servicioDominante}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="seccion seccion--alt">
    <div class="contenedor estrecho">
      <EnlacesServicios slugs={b.servicios} titulo={`Servicios en ${b.nombre}`} />

      <EnlacesBlog claves={b.articulos} titulo={`Lo que suele fallar en ${b.nombre}`} />

      <div style="margin-top:2rem">
        <h3>Otros distritos de Sevilla capital</h3>
        <p>Cada uno con el servicio que pide su parque edificado, que no es el mismo.</p>
        <ul class="enlaces">
          {
            otros.map((o) => (
              <li><a href={`/zonas/sevilla/${o.slug}`}>{o.nombre}</a></li>
            ))
          }
          <li><a href="/zonas/sevilla"><strong>Sevilla capital</strong></a></li>
          <li><a href="/zonas">Área metropolitana</a></li>
        </ul>
      </div>

      <div style="margin-top:2rem">
        <h3>Según quién nos llame</h3>
        <ul class="enlaces">
          {SEGMENTOS.map((sg) => <li><a href={sg.href}>{sg.nombre}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <Faqs faqs={b.faqs} titulo={`Preguntas frecuentes en ${b.nombre}`} />

  <Cta
    titulo={`¿Hablamos de tu edificio en ${b.nombre}?`}
    texto="Cuéntanos qué está pasando y te decimos si se resuelve con limpieza o si conviene inspeccionar la conducción antes."
  />
</Base>
