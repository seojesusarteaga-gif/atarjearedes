---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import Citable from '../../../components/Citable.astro';
import Faqs from '../../../components/Faqs.astro';
import Cta from '../../../components/Cta.astro';
import EnlacesServicios from '../../../components/EnlacesServicios.astro';
import { BARRIOS } from '../../../data/barrios';

export function getStaticPaths() {
  return BARRIOS.map((b) => ({ params: { barrio: b.slug }, props: { b } }));
}

const { b } = Astro.props;
---

<Base
  title={b.title}
  meta={b.meta}
  ruta={`/zonas/sevilla/${b.slug}`}
  imagen={`/img/zonas/${b.slug}.svg`}
  faqs={b.faqs}
  servicio={{ nombre: b.servicioDominante, descripcion: b.meta }}
  migas={[
    { nombre: 'Inicio', href: '/' },
    { nombre: 'Zonas', href: '/zonas' },
    { nombre: 'Sevilla capital', href: '/zonas/sevilla' },
    { nombre: b.nombre, href: `/zonas/sevilla/${b.slug}` },
  ]}
>
  <Hero
    h1={b.h1}
    entradilla={b.servicioDominante}
    imagen={`/img/zonas/${b.slug}.svg`}
    alt={`${b.servicioDominante} en ${b.nombre}, Sevilla`}
  />

  <section class="seccion">
    <div class="contenedor estrecho">
      <Citable texto={b.citable} />

      <h2>Por qué {b.nombre} necesita este servicio y no otro</h2>
      <p>{b.porQue}</p>

      <table>
        <tbody>
          <tr><th scope="row">Parque edificado</th><td>{b.parque}</td></tr>
          <tr><th scope="row">Servicio con más recorrido</th><td>{b.servicioDominante}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="seccion seccion--alt">
    <div class="contenedor estrecho">
      <EnlacesServicios slugs={b.servicios} titulo={`Servicios en ${b.nombre}`} />
      <p style="margin-top:1.4rem">
        <a href="/zonas/sevilla">Ver todos los distritos de Sevilla capital</a>
      </p>
    </div>
  </section>

  <Faqs faqs={b.faqs} titulo={`Preguntas frecuentes en ${b.nombre}`} />

  <Cta
    titulo={`¿Hablamos de tu edificio en ${b.nombre}?`}
    texto="Cuéntanos qué está pasando y te decimos si se resuelve con limpieza o si conviene inspeccionar la conducción antes."
  />
</Base>
