{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "atarjearedes.vercel.app"
          }
        }
      ],
      "destination": "https://atarjearedes.es/:path",
      "statusCode": 301
    }
  ]
}
